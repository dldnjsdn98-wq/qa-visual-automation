{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-visual-automation:ocr:canonical-regions:v1",
  "type": "array",
  "maxItems": 1000,
  "items": {"$ref": "#/$defs/region"},
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["region_index", "text", "confidence", "confidence_semantics", "detection_confidence", "detection_confidence_unavailable_reason", "polygon", "bbox", "clipped", "engine_region_index"], "properties": {"region_index": {"type": "integer", "minimum": 0, "maximum": 999}, "text": {"type": "string", "maxLength": 10000}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "confidence_semantics": {"const": "recognition"}, "detection_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "detection_confidence_unavailable_reason": {"type": ["string", "null"], "enum": ["NOT_EXPOSED_BY_PROFILE", null]}, "polygon": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"$ref": "#/$defs/point"}}, "bbox": {"$ref": "#/$defs/bbox"}, "clipped": {"type": "boolean"}, "engine_region_index": {"type": "integer", "minimum": 0}}}
  }
}
